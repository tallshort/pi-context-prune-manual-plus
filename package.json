{
  "name": "@tallshort/pi-context-prune-manual-plus",
  "version": "1.6.2",
  "description": "Pi extension fork with manual on-demand context pruning and safe recovery enhancements.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && esbuild index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --sourcemap --external:@earendil-works/pi-ai --external:@earendil-works/pi-coding-agent --external:@earendil-works/pi-tui",
    "check": "npm run build && npm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "test": "vitest run",
    "prepack": "npm run build && npm run check:package"
  },
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tallshort/pi-context-prune-manual-plus.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tallshort/pi-context-prune-manual-plus/issues"
  },
  "homepage": "https://github.com/tallshort/pi-context-prune-manual-plus#readme",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.87.0",
    "@earendil-works/pi-coding-agent": ">=0.87.0",
    "@earendil-works/pi-tui": ">=0.87.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.0",
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-tui": "^0.87.0",
    "@sinclair/typebox": "^0.34.52",
    "esbuild": "^0.28.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@google/genai@2.21.0": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.28.2": true
  }
}
